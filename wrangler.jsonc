{
  "name": "042tailoring-rgb",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/inquiries",
      "/api/admin/*",
      "/images/products/*",
      "/images/portfolio/*",
      "/portfolio.json"
    ]
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "4216102026",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "042tailoring-rgb",
    "GITHUB_BRANCH": "main",
    "GITHUB_REPOS": "042tailoring-aiai,042tailoring-rgb",
    "ADMIN_ENABLED": "false",
    "ADMIN_URL": "https://042tailoring-admin.progen-web.workers.dev/admin"
  }
}
